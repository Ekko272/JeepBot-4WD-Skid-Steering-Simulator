<?xml version="1.0"?>
<package format="3">
  <name>jeepbot_sim</name>
  <version>0.1.0</version>
  <description>JeepBot four-wheel skid-steer simulation and virtual VESCs</description>
  <maintainer email="maintainer@example.invalid">JeepBot team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <exec_depend>python3-launch</exec_depend>
  <exec_depend>python3-launch-ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
