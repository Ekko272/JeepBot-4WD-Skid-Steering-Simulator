<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="jeepbot_flat">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.4 0.3 -0.9</direction>
    </light>
    <model name="ground"><static>true</static><link name="ground">
      <collision name="floor"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
      <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry><material><ambient>0.65 0.70 0.63 1</ambient><diffuse>0.65 0.70 0.63 1</diffuse></material></visual>
    </link></model>
    <model name="obstacle"><static>true</static><pose>2 1 0.25 0 0 0</pose><link name="block">
      <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry><material><ambient>0.8 0.3 0.15 1</ambient><diffuse>0.8 0.3 0.15 1</diffuse></material></visual>
    </link></model>
    <!-- Dimensions below are illustrative, NOT taken from physical JeepBot. -->
    <model name="jeepbot">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.34 0 0 0</pose>
        <inertial><mass>15</mass><inertia><ixx>0.5</ixx><iyy>1.0</iyy><izz>1.1</izz></inertia></inertial>
        <collision name="body_collision"><geometry><box><size>0.85 0.48 0.24</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.85 0.48 0.24</size></box></geometry><material><ambient>0.19 0.33 0.55 1</ambient><diffuse>0.19 0.33 0.55 1</diffuse></material></visual>
        <visual name="hood"><pose>0.22 0 0.16 0 0 0</pose><geometry><box><size>0.30 0.45 0.06</size></box></geometry><material><ambient>0.14 0.25 0.43 1</ambient><diffuse>0.14 0.25 0.43 1</diffuse></material></visual>
      </link>
      <!-- +x front, +y left, z up. Four independently rotating wheels. -->
      <link name="front_left_wheel">
        <pose>0.29 0.34 0.16 1.57079632679 0 0</pose>
        <inertial><mass>1.2</mass><inertia><ixx>0.018</ixx><iyy>0.018</iyy><izz>0.018</izz></inertia></inertial>
        <collision name="tire_collision">
          <geometry><cylinder><radius>0.16</radius><length>0.09</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.8</mu2><slip1>0.03</slip1><slip2>0.03</slip2></ode></friction></surface>
        </collision>
        <visual name="tire"><geometry><cylinder><radius>0.16</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      </link>
      <joint name="front_left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>front_left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>30</effort><velocity>20</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis>
      </joint>
      <link name="front_right_wheel">
        <pose>0.29 -0.34 0.16 1.57079632679 0 0</pose>
        <inertial><mass>1.2</mass><inertia><ixx>0.018</ixx><iyy>0.018</iyy><izz>0.018</izz></inertia></inertial>
        <collision name="tire_collision">
          <geometry><cylinder><radius>0.16</radius><length>0.09</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.8</mu2><slip1>0.03</slip1><slip2>0.03</slip2></ode></friction></surface>
        </collision>
        <visual name="tire"><geometry><cylinder><radius>0.16</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      </link>
      <joint name="front_right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>front_right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>30</effort><velocity>20</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis>
      </joint>
      <link name="rear_left_wheel">
        <pose>-0.29 0.34 0.16 1.57079632679 0 0</pose>
        <inertial><mass>1.2</mass><inertia><ixx>0.018</ixx><iyy>0.018</iyy><izz>0.018</izz></inertia></inertial>
        <collision name="tire_collision">
          <geometry><cylinder><radius>0.16</radius><length>0.09</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.8</mu2><slip1>0.03</slip1><slip2>0.03</slip2></ode></friction></surface>
        </collision>
        <visual name="tire"><geometry><cylinder><radius>0.16</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      </link>
      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>rear_left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>30</effort><velocity>20</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis>
      </joint>
      <link name="rear_right_wheel">
        <pose>-0.29 -0.34 0.16 1.57079632679 0 0</pose>
        <inertial><mass>1.2</mass><inertia><ixx>0.018</ixx><iyy>0.018</iyy><izz>0.018</izz></inertia></inertial>
        <collision name="tire_collision">
          <geometry><cylinder><radius>0.16</radius><length>0.09</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.8</mu2><slip1>0.03</slip1><slip2>0.03</slip2></ode></friction></surface>
        </collision>
        <visual name="tire"><geometry><cylinder><radius>0.16</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      </link>
      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>rear_right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><effort>30</effort><velocity>20</velocity></limit><dynamics><damping>0.2</damping></dynamics></axis>
      </joint>
      <!-- Gazebo built-in 4-wheel differential skid-drive approximation. -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>0.68</wheel_separation>
        <wheel_radius>0.16</wheel_radius>
        <topic>/jeepbot/cmd_vel</topic>
        <odom_topic>/jeepbot/odometry</odom_topic>
        <max_linear_velocity>0.7</max_linear_velocity>
        <min_linear_velocity>-0.7</min_linear_velocity>
        <max_angular_velocity>1.5</max_angular_velocity>
        <min_angular_velocity>-1.5</min_angular_velocity>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
